---
import Page from "../layouts/Page.astro";
import { profile, projects } from "../data/profile";
import { SCENES } from "../data/scenes";
import { KINDS, getPosts, isoDate } from "../data/blog";

const latest = (await getPosts()).slice(0, 3);
// the three projects that best say what I do; the rest live on /work
const FEATURED = ["edge-dl", "mindroid", "tet-hlan-rl"];
const featured = FEATURED.map((slug) => projects.find((p) => p.slug === slug)!);
---

<Page
  title={profile.name}
  description={`${profile.name}, ${profile.title}. Embedded ML, edge AI and on-device LLMs, plus robotics, backend and DevOps work.`}
>
  <section class="hero" aria-labelledby="name">
    <p class="part">embedded-ml / edge-ai / edge-llm · {profile.location}</p>
    <h1 id="name">Hein Htet <span>(Jeremy)</span></h1>
    <p class="role">{profile.title}</p>
    <p class="lede">
      I put models on small hardware: embedded ML, edge AI, and LLMs that run on the device itself. Right now I lead AI
      architecture at Magick Mind, giving robots and wearables an on-platform mind. Before that I took a humanoid's walking
      policy from simulation onto the robot at 50 Hz, and squeezed CNNs and small LLMs onto a Jetson Nano.
    </p>
    <ul class="links">
      <li><a href="/work/">work</a></li>
      <li><a href="/about/">about</a></li>
      <li><a href="/hein-htet-resume.pdf" download>resume.pdf</a></li>
    </ul>
  </section>

  <section class="live" aria-labelledby="live-h">
    <h2 class="eyebrow" id="live-h">Live <span>pick a world</span></h2>
    <div class="filter" role="group" aria-label="Pick a world">
      {
        SCENES.map((sc, i) => (
          <button type="button" data-scene={i} aria-pressed={i === 0 ? "true" : "false"}>
            {sc.tab}
          </button>
        ))
      }
    </div>
    <div class="viewer">
      <canvas id="scene-canvas" aria-hidden="true"></canvas>
    </div>
    <div class="scene-caps" aria-live="polite">
      {
        SCENES.map((sc, i) => (
          <div data-cap={i} hidden={i !== 0}>
            <span class="k">{sc.kicker}</span>
            <h3>{sc.title}</h3>
            <p>{sc.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="sel-h">
    <h2 class="eyebrow" id="sel-h">Selected work</h2>
    <ol class="posts">
      {
        featured.map((p) => (
          <li>
            <span class="when">{p.year}</span>
            <div>
              <a class="t" href={`/work/#p-${p.slug}`}>
                {p.title}
              </a>
              <p>{p.summary}</p>
              {p.metric && <p class="meta">{p.metric}</p>}
            </div>
          </li>
        ))
      }
    </ol>
    <p class="more-link"><a href="/work/">all work →</a></p>
  </section>

  <section aria-labelledby="writing-h">
    <h2 class="eyebrow" id="writing-h">Writing</h2>
    {
      latest.length ? (
        <ol class="posts">
          {latest.map((p) => (
            <li>
              <time datetime={isoDate(p.data.date)}>{isoDate(p.data.date)}</time>
              <div>
                <a class="t" href={`/blog/${p.id}/`}>
                  {p.data.title}
                </a>
                {p.data.draft && <span class="badge">draft</span>}
                <p>{p.data.description}</p>
                <p class="meta">{KINDS[p.data.kind].label}</p>
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty">First posts are on the way: open-source write-ups and notes on the theory behind edge AI.</p>
      )
    }
    <p class="more-link"><a href="/blog/">all writing →</a></p>
  </section>

  <script>
    import "../scripts/home";
  </script>
</Page>
